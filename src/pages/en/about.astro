---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const about = (await getEntry('about', 'en'))!;
const { Content } = await render(about);
---

<BaseLayout lang="en" title="About" description="About Gabriel Carvalho — background, current focus, and how this site runs.">
  <article class="prose" style="padding-block: 2rem 3rem;">
    <h1>About</h1>
    <Content />
  </article>
</BaseLayout>
