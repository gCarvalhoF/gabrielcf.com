---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (e) => e.id.startsWith('en/') && !e.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace('en/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  author: { '@type': 'Person', name: 'Gabriel Carvalho' },
};
---

<BaseLayout
  lang="en"
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover ?? undefined}
  type="article"
  jsonLd={jsonLd}
>
  <article class="prose" style="padding-block: 2rem 3rem;">
    <h1 style="margin-bottom: 0.25rem;">{post.data.title}</h1>
    <time datetime={post.data.publishDate.toISOString()} style="font-size: 0.9rem; color: var(--color-text-muted);">
      {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <div style="margin: 1rem 0;">
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <Content />
  </article>
</BaseLayout>
