---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', (e) => e.id.startsWith('pt/') && !e.data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout lang="pt" title="Blog" description="Textos de Gabriel Carvalho.">
  <h1 style="padding-top: 2rem;">Blog</h1>
  <ul style="list-style: none; padding: 0; margin-top: 1.5rem; margin-bottom: 3rem; display: grid; gap: 1.25rem;">
    {posts.map((post) => (
      <li>
        <a href={`/pt/blog/${post.id.replace('pt/', '')}/`} style="font-size: 1.2rem;">
          {post.data.title}
        </a>
        <p style="margin: 0.25rem 0 0; color: var(--color-text-muted);">{post.data.description}</p>
        <time datetime={post.data.publishDate.toISOString()} style="font-size: 0.85rem; color: var(--color-text-muted);">
          {post.data.publishDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </li>
    ))}
  </ul>
</BaseLayout>
