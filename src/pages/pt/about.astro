---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const about = (await getEntry('about', 'pt'))!;
const { Content } = await render(about);
---

<BaseLayout lang="pt" title="Sobre" description="Sobre Gabriel Carvalho — trajetória, foco atual e como este site funciona.">
  <article class="prose" style="padding-block: 2rem 3rem;">
    <h1>Sobre</h1>
    <Content />
  </article>
</BaseLayout>
