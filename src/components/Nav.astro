---
interface Props {
  lang: 'en' | 'pt';
}
const { lang } = Astro.props;

const copy = {
  en: { home: 'Gabriel Carvalho', about: 'About', projects: 'Projects', blog: 'Blog', contact: 'Contact', switch: 'PT' },
  pt: { home: 'Gabriel Carvalho', about: 'Sobre', projects: 'Projetos', blog: 'Blog', contact: 'Contato', switch: 'EN' },
};
const t = copy[lang];
const otherLang = lang === 'en' ? 'pt' : 'en';

const path = Astro.url.pathname.replace(/^\/(en|pt)/, '');
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="wrap" style="display: flex; align-items: baseline; justify-content: space-between; padding-block: 2rem; flex-wrap: wrap; gap: 1rem;">
  <a href={`/${lang}/`} style="font-family: var(--font-serif); font-size: 1.15rem; text-decoration: none; color: var(--color-text);">
    {t.home}
  </a>
  <nav style="display: flex; gap: 1.25rem; align-items: center; font-size: 0.95rem;">
    <a href={`/${lang}/about/`}>{t.about}</a>
    <a href={`/${lang}/projects/`}>{t.projects}</a>
    <a href={`/${lang}/blog/`}>{t.blog}</a>
    <a href={`/${lang}/contact/`}>{t.contact}</a>
    <a href={`/${otherLang}${path}`} aria-label={`Switch language to ${otherLang === 'en' ? 'English' : 'Portuguese'}`} style="border: 1px solid var(--color-border); border-radius: 999px; padding: 0.15rem 0.6rem; font-size: 0.8rem;">
      {t.switch}
    </a>
  </nav>
</header>
