# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Build-time (inlined into the client bundle by Vite — not secret, but must be
# passed as a Docker build arg, not a runtime -e; see Dockerfile/docker-compose.yml).
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Runtime secrets — from the GitHub App's settings page (Client ID / generate a
# client secret). Never bake these into the image.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Session signing key. Generate with: openssl rand -base64 32
KEYSTATIC_SECRET=
